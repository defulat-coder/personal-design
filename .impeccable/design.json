      "css": ".ds-header{display:flex;align-items:center;justify-content:space-between;min-height:88px;padding:20px 48px;background:var(--color-paper);color:var(--color-ink);}.ds-header a{font:600 17px/1.3 var(--font-sans);color:inherit;text-decoration:none;}.ds-header a:hover{text-decoration:underline;}.ds-header button{min-height:44px;padding:8px 16px;border:1px solid var(--color-hairline-strong);border-radius:999px;background:var(--color-paper);color:var(--color-body);}.ds-header button:hover{background:var(--color-subtle);}.ds-header :focus-visible{outline:2px solid var(--color-ink);outline-offset:3px;}@media(max-width:639px){.ds-header{min-height:72px;padding:12px 20px;}}"
    },
    {
      "name": "Category",
      "kind": "chip",
      "description": "下划线分类选择，44px 操作高度。",
      "html": "<button class=\"ds-category\" aria-pressed=\"true\">全部 <span>24</span></button>",
      "css": ".ds-category{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:10px 0 13px;border:0;border-bottom:1px solid transparent;background:transparent;color:var(--color-ink-soft);font:14px/1.75 var(--font-sans);transition:color 100ms ease,border-color 100ms ease;}.ds-category[aria-pressed=true]{color:var(--color-ink);border-bottom-color:var(--color-ink);font-weight:600;}.ds-category span{font-size:11px;font-weight:400;font-variant-numeric:tabular-nums;}.ds-category:hover{color:var(--color-ink);}.ds-category:focus-visible{outline:2px solid var(--color-ink);outline-offset:-2px;}"
    },
    {
      "name": "Information Section",
      "kind": "custom",
      "description": "详情媒体下方的开放资料区，不使用检查面板。",
      "html": "<section class=\"ds-info\"><h2>原始信息</h2><p>作者、出处与原始内容数据</p><a href=\"#\">查看原始出处</a></section>",
      "css": ".ds-info{padding-top:32px;border-top:1px solid var(--color-hairline);color:var(--color-body);font:14px/1.75 var(--font-sans);}.ds-info h2{color:var(--color-ink);font-size:20px;line-height:1.35;margin-bottom:16px;}.ds-info a{color:var(--color-ink);}.ds-info a:hover{text-decoration:none;}.ds-info a:focus-visible{outline:2px solid var(--color-ink);outline-offset:3px;}"
    },
    {
      "name": "Timeline Project",
      "kind": "custom",
      "description": "日期在细轨道上方，单一原生作品链接在下方；无卡片面板或待机动画。",
      "html": "<article class=\"ds-entry\"><time datetime=\"2026-09-01\">2026.09.01</time><div class=\"ds-rail\" aria-hidden=\"true\"></div><a href=\"#\"><h2>布局参考 ↗</h2><p>从真实内容中寻找构图灵感</p><span>浏览作品 →</span></a></article>",
      "css": ".ds-entry{width:320px;color:var(--color-ink);font-family:var(--font-sans);}.ds-entry time{font-size:13px;line-height:20px;color:var(--color-ink-soft);font-variant-numeric:tabular-nums;}.ds-rail{position:relative;height:1px;margin:27px 0 29px;background:var(--color-hairline-strong);}.ds-rail:before{content:\"\";position:absolute;width:7px;height:7px;top:-3px;border-radius:50%;background:var(--color-ink);}.ds-entry a{display:block;color:inherit;text-decoration:none;border-radius:4px;}.ds-entry h2{margin:0;font-size:24px;font-weight:500;line-height:1.35;letter-spacing:0;}.ds-entry p{font-size:14px;line-height:1.75;color:var(--color-ink-soft);}.ds-entry a>span{font-size:12px;color:var(--color-ink-soft);}.ds-entry a:is(:hover,:focus-visible) h2{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:6px;}.ds-entry a:focus-visible{outline:2px solid var(--color-ink);outline-offset:8px;}"
    }
  ],
  "narrative": {
    "northStar": "随手可查的设计参考（Design Within Reach）",
    "overview": "本站采用 OpenDesign 的中性色、Albert Sans、清晰中文排印与克制控件；真实媒体承担主要视觉内容。源快照见 [OpenDesign 规范](docs/design/open-design/README.md)，采用与适配见 [rules.md](docs/design/open-design/rules.md)。本文记录 V2 当前实现，不把历史布局当作产品约束，也不把源码对齐等同于用户认可。\n\n首页是稀疏、单色的「作品时间轴」，作为个人作品集索引：产品按注册表 `date` 从早到晚横向排列，日期位于细轨上方，产品标题、简短用途和真实媒体预览位于下方；虚线末端通向「更多作品」。大量留白与细刻度建立节奏，每件作品是单一原生链接。全站仍仅保留轻量品牌/首页链接与主题开关，不设置侧栏或顶部产品菜单。",
    "keyCharacteristics": [
      "白色页面与浅灰媒体衬底，深色使用同一组语义角色。",
      "首页为单色横向作品时间轴，按 `date` 从左到右排列并延伸至「更多作品」；内页以返回列表、相邻内容和首页链接提供上下文导航。",
      "布局参考用八本分类书籍与双页画册，搜索命中定位所在跨页；灵感保留稳定内容网格、可视视频动态预览与单一详情去向。",
      "边框留给控件和分组边界，媒体之外减少包框；组件样式归相邻 CSS Module。"
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "新表面使用成套语义主题；详情灯箱保持恒定暗房与亮色焦点环。",
        "section": "colors"
      },
      {
        "name": "The Chinese Typesetting Rule",
        "body": "中文标题字距为 0、行高 1.35，正文行高 1.75；用空间和层级组织内容，不用负字距压缩中文。",
        "section": "typography"
      },
      {
        "name": "The Open Reading Surface Rule",
        "body": "标题、说明和出处直接落在阅读平面，边界用于分组与操作，不把每段资料套进独立面板。",
        "section": "elevation"
      },
      {
        "name": "The Neutral Timeline Rule",
        "body": "首页轨道、日期、标题和操作沿用中性语义 token；真实媒体提供内容颜色。",
        "section": "colors"
      },
      {
        "name": "The Physical Book Surface Exception",
        "body": "布局参考书架、双页画册和首页对应书脊预览使用局部实体书配色、恒定米白纸面与装订阴影。八本分类书籍按共同底线对齐，真实图鉴各占一页；其余页面保持中性主题。配色见 DESIGN.md 的 book-*，实现归 layout-bookshelf.tsx 与相邻 CSS Module。",
        "section": "colors"
      },
      {
        "name": "The Shared Control Rule",
        "body": "所有操作复用44px共享按钮，文字胶囊、图标圆形，18px/1.6px线条；主动作实心、连续浏览描边、返回与清除透明。搜索常驻即时过滤。详见 docs/design/controls/README.md。",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** 让首页承担产品选择，内页只提供上下文返回和阅读操作。",
      "**Do** 让布局搜索进入所属分类的命中跨页，画册每页使用一张真实图鉴；灵感保持稳定网格与单一详情链接。",
      "**Do** 让详情标题在媒体之前、实际说明在媒体之后自然展开，原作链接放在作者栏。",
      "**Do** 保留主题、可见焦点、原生视频控制、滚动自动追加与返回现场。",
      "**Do** 沿用源 tokens、中文排印、共享按钮和局部 CSS 归属。",
      "**Do** 让首页的日期、细轨道、真实媒体和充足留白表达作品的时间顺序。"
    ],
    "donts": [
      "**Don't** 恢复全站菜单、固定侧栏或自动移动内容墙。",
      "**Don't** 将灵感列表点击改为灯箱中转、列表自动滚动或重复追加已加载内容；布局画册以翻页为主，图片点击放大，放大即详情，不再提供详情跳转；细线圆形翻页按钮位于书本左右中部。",
      "**Don't** 用固定全高媒体井、窄资料侧栏或层层面板挤压阅读。",
      "**Don't** 因保留线路色 tokens 而恢复装饰线路色、站牌或待机循环动效。",
      "**Don't** 删除缺图条目、原作出处或包内原始数据 。首页不添加关于或许可说明，也不另建说明文档。"
    ]
  }
}
